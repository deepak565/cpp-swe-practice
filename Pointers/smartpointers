// Types:
// 1. std::unique_ptr
// Allows only one owership of the object
//2. std::shared_ptr
// Allows multiple ownership of the object (reference count is maintained)
//3. std::weak_ptr
//it is special type of smart pointer that does not count the reference

#include <iostream>
using namespace std;

class MyInt {
 private:
    int* data;
 public:
    explicit MyInt(int* ptr) : data(ptr) {}
    ~MyInt() {
        delete data;
    }
    int& operator*() {
        return *data;
    }
};

int main() {
    int *p = new int(10);
    MyInt myint = MyInt(p);
    cout<<"value :"<<*myint<<endl;
    return 0;
}

